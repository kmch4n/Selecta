# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicit text types
*.astro   text eol=lf
*.css     text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.svg     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf

# Binary assets (never normalize)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
