---
export interface Props {
    showConvertLink?: boolean;
    showQuizLink?: boolean;
}

const { showConvertLink = false, showQuizLink = false } = Astro.props;
---

<nav class="nav" aria-label="メインナビゲーション">
    <a href="/" class="nav__mark">Select<span class="nav__dot">a</span></a>
    <div class="nav__links">
        {showQuizLink && <a href="/" class="nav__link">クイズ</a>}
        {showConvertLink && <a href="/convert" class="nav__link">変換ツール</a>}
    </div>
</nav>
