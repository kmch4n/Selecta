---
export interface Props {
    title: string;
    description?: string;
}

const { title, description = 'JSON や URL からクイズを読み込み、ブラウザだけで解いて、間違えた問題を復習する。選択式クイズ PWA。' } = Astro.props;

// Absolute URLs for canonical / OG cards. Astro.site is set in astro.config.mjs;
// crawlers require absolute URLs, so we resolve against it.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og.png', Astro.site);

import Footer from './Footer.astro';

// The PWA integration generates sw.js, registerSW.js, and the web manifest, but
// it cannot inject them into Astro pages: it relies on Vite's transformIndexHtml
// hook, which never fires for HTML that Astro emits itself. Without the two
// set:html fragments below, the service worker is built and then never
// registered — which is exactly what was happening.
import { pwaInfo } from 'virtual:pwa-info';

// Self-hosted so the PWA keeps working offline and no request leaves the origin.
// These are the chunked entry points: each pulls a stylesheet of unicode-range
// @font-face rules, so the browser downloads only the ranges a page actually
// renders. Do NOT switch to the `japanese-*.css` entries — those are single
// ~1.4 MB files with no range splitting.
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '@fontsource/jetbrains-mono/500.css';

import '../styles/tokens.css';
import '../styles/main.css';
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <meta name="theme-color" content="#fbfcfd" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Selecta" />
        <meta property="og:locale" content="ja_JP" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Selecta — 選択式クイズを、手元のファイルから。" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        {/* pwaInfo is undefined on the dev server, where the PWA is off on
            purpose — a service worker caching between edits costs more than it
            gives. Both fragments are guarded so dev renders without them. */}
        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    </head>
    <body>
        <slot />
        <Footer />
        {pwaInfo?.registerSW && <Fragment set:html={pwaInfo.registerSW.scriptTag} />}
    </body>
</html>
