---
import Layout from '../components/Layout.astro';
import NavBar from '../components/NavBar.astro';
---

<Layout title="Selecta">
    <NavBar showConvertLink={true} />

    <main class="shell">
        <section id="file-input-section">
            <div class="hero">
                <h1 class="hero__title">4択クイズを、<wbr />手元のファイルから。</h1>
                <p class="hero__lede">
                    読み込みも採点もブラウザの中だけで完結します。ファイルはどこにも送られません。
                </p>
                <div class="hero__act">
                    <button type="button" class="btn btn--lg" id="load-sample-btn">サンプルで試す</button>
                    <p class="help">一般常識10問。そのまま始まります。</p>
                </div>
            </div>

            <div class="card">
                <div class="loader__head">
                    <h2 class="loader__title">自分のクイズを読み込む</h2>
                    <div class="seg" role="tablist" aria-label="読み込み方法">
                        <button type="button" class="seg__btn is-active" data-source="file" role="tab" aria-selected="true">
                            ファイル
                        </button>
                        <button type="button" class="seg__btn" data-source="url" role="tab" aria-selected="false">
                            URL
                        </button>
                    </div>
                </div>

                <div id="file-source" class="source-content">
                    <label class="file-btn">
                        <input type="file" accept=".json" id="quiz-file" />
                        <span class="btn btn--soft">JSONを選ぶ</span>
                    </label>
                </div>

                <div id="url-source" class="source-content" style="display: none;">
                    <div class="field">
                        <label class="label" for="quiz-urls">クイズファイルのURL（複数可、改行区切り）</label>
                        <textarea
                            class="textarea"
                            id="quiz-urls"
                            placeholder="https://example.com/quiz1.json&#10;https://example.com/quiz2.json"
                            rows="4"></textarea>
                        <p class="help">複数指定すると、順番に連続して出題されます。</p>
                    </div>
                    <div class="field">
                        <button type="button" class="btn btn--soft" id="load-urls-btn">読み込む</button>
                    </div>
                </div>
            </div>

            <div class="card" id="review-section" style="display: none;">
                <div class="loader__head">
                    <h2 class="loader__title">苦手な問題を復習する</h2>
                    <span class="label-mono" id="review-count"></span>
                </div>
                <p class="help" id="review-lede"></p>
                <div class="btn-row">
                    <button type="button" class="btn" id="review-start-btn">復習する</button>
                    <button type="button" class="btn btn--outline" id="review-reset-btn">苦手リストをリセット</button>
                </div>
            </div>
        </section>

        <section id="quiz-section" style="display: none;">
            <div class="quiz__meta">
                <span class="label-mono quiz__title" id="quiz-title"></span>
                <span class="label-mono" id="question-counter"></span>
            </div>
            <div class="track" id="answer-track" aria-hidden="true"></div>

            <h2 class="quiz__q" id="question-text"></h2>

            <div class="stack-lg">
                <div id="options-container" class="opts"></div>

                <div id="result-section" class="verdict" style="display: none;">
                    <div id="result-text"></div>
                </div>

                <div class="btn-row" id="quiz-buttons">
                    <button type="button" id="prev-btn" class="btn btn--outline" disabled>前へ</button>
                    <button type="button" id="next-btn" class="btn" data-mode="question" disabled>次へ</button>
                    <button type="button" id="restart-btn" class="btn btn--outline">やり直す</button>
                    <button type="button" id="new-quiz-btn" class="btn btn--outline" style="display: none;">
                        別のクイズ
                    </button>
                </div>
            </div>
        </section>
    </main>

    <script>
        interface QuizData {
            meta: {
                title: string;
                description?: string;
                version?: string;
                created?: string;
            };
            questions: Array<{
                id: string;
                question: string;
                options: string[];
                correct: number;
                explanation?: string;
                deck?: string;
                tags?: string[];
                difficulty?: string;
            }>;
        }

        type QuizQuestion = QuizData['questions'][number];

        interface ReviewRecord {
            q: string;
            options: string[];
            correct: number;
            explanation?: string;
            deck?: string;
            title: string;
            wrong: number; // total misses, kept as a stat and never decremented
            seen: number;
            weak: boolean; // currently in the review list
            firstMissed: number;
            lastSeen: number;
        }

        interface ReviewData {
            version: number;
            records: Record<string, ReviewRecord>;
        }

        /**
         * Persists the questions the user has missed so they can be reviewed
         * across sessions. Records are keyed by the *content* of a question
         * (text + options), not its `id`, so the same question is recognised
         * regardless of which file or title it arrives in — and an `id`
         * collision between two unrelated files can't merge distinct questions.
         * A missed question enters the weak list; answering it correctly clears
         * the flag while the running miss count is preserved.
         */
        class ReviewStore {
            private static readonly KEY = 'selecta.review.v1';
            private static readonly VERSION = 1;

            private data: ReviewData = { version: ReviewStore.VERSION, records: {} };
            private available = true;

            constructor() {
                this.load();
            }

            private load() {
                try {
                    const raw = localStorage.getItem(ReviewStore.KEY);
                    if (raw) {
                        const parsed = JSON.parse(raw) as ReviewData;
                        if (parsed && typeof parsed === 'object' && parsed.records) {
                            this.data = { version: ReviewStore.VERSION, records: parsed.records };
                        }
                    }
                } catch {
                    // Corrupt JSON or unavailable storage: start empty and keep
                    // the app usable rather than throwing on boot.
                    this.data = { version: ReviewStore.VERSION, records: {} };
                    this.available = false;
                }
            }

            private save() {
                if (!this.available) return;
                try {
                    localStorage.setItem(ReviewStore.KEY, JSON.stringify(this.data));
                } catch {
                    // Quota exceeded or private-mode denial: stop persisting but
                    // let the current session carry on.
                    this.available = false;
                }
            }

            /** FNV-1a 32-bit over the normalised question text and its options. */
            private hash(question: string, options: string[]): string {
                const norm = (s: string) => s.normalize('NFC').trim();
                const src = norm(question) + '' + options.map(norm).join('');
                let h = 0x811c9dc5;
                for (let i = 0; i < src.length; i++) {
                    h ^= src.charCodeAt(i);
                    h = Math.imul(h, 0x01000193);
                }
                return (h >>> 0).toString(36);
            }

            /** Record one confirmed answer. Correct answers to never-missed
             *  questions are intentionally not stored. */
            record(question: QuizQuestion, isCorrect: boolean, title: string) {
                const key = this.hash(question.question, question.options);
                const now = Date.now();
                let rec = this.data.records[key];

                if (isCorrect) {
                    if (!rec) return;
                    rec.weak = false;
                    rec.seen += 1;
                    rec.lastSeen = now;
                } else {
                    if (!rec) {
                        rec = this.data.records[key] = {
                            q: question.question,
                            options: question.options,
                            correct: question.correct,
                            explanation: question.explanation,
                            deck: question.deck,
                            title,
                            wrong: 0,
                            seen: 0,
                            weak: true,
                            firstMissed: now,
                            lastSeen: now,
                        };
                    }
                    rec.wrong += 1;
                    rec.seen += 1;
                    rec.weak = true;
                    rec.lastSeen = now;
                }
                this.save();
            }

            /** Weak questions, most-missed first. */
            getWeak(): ReviewRecord[] {
                return Object.values(this.data.records)
                    .filter((r) => r.weak)
                    .sort((a, b) => b.wrong - a.wrong || a.firstMissed - b.firstMissed);
            }

            weakCount(): number {
                return this.getWeak().length;
            }

            /** Build a playable quiz from stored records — no source file needed. */
            buildQuiz(records: ReviewRecord[]): QuizQuestion[] {
                return records.map((r, i) => ({
                    id: `review-${i}`,
                    question: r.q,
                    options: r.options,
                    correct: r.correct,
                    explanation: r.explanation,
                    deck: r.deck,
                }));
            }

            /** Empty the weak list; miss-count history is kept. */
            clearWeak() {
                for (const key of Object.keys(this.data.records)) {
                    this.data.records[key].weak = false;
                }
                this.save();
            }
        }

        class QuizApp {
            private quizData: QuizData | null = null;
            private currentQuestionIndex = 0;
            private userAnswers: (number | null)[] = [];
            private isAnswered = false;
            private selectedOption = -1;
            private isConfirmed = false;
            private quizQueue: QuizData[] = [];
            private currentQuizIndex = 0;
            private allResults: Array<{title: string; correct: number; total: number}> = [];
            private reviewStore = new ReviewStore();
            private sessionWrong: QuizQuestion[] = [];

            constructor() {
                this.setupEventListeners();
                this.renderReviewSection();
                this.autoLoadFromQuery();
            }

            /**
             * Auto-load quizzes named in the URL, e.g. ?source=https://…/quiz.json
             * (repeat the parameter for several: ?source=a&source=b). A shared link
             * then starts the quiz with no typing — handing someone a problem set is
             * just handing them a URL.
             */
            private autoLoadFromQuery() {
                const sources = new URLSearchParams(location.search)
                    .getAll('source')
                    .map((s) => s.trim())
                    .filter(Boolean);

                if (sources.length === 0) return;

                // Mirror the sources into the URL tab so that, if the auto-load
                // fails (bad link, offline, CORS), the recipient still sees them
                // and can retry with the button.
                this.switchSourceTab('url');
                (document.getElementById('quiz-urls') as HTMLTextAreaElement).value = sources.join('\n');

                void this.loadQuizzesFromUrls(sources);
            }

            private setupEventListeners() {
                const fileInput = document.getElementById('quiz-file') as HTMLInputElement;
                const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
                const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
                const restartBtn = document.getElementById('restart-btn') as HTMLButtonElement;
                const newQuizBtn = document.getElementById('new-quiz-btn') as HTMLButtonElement;
                const loadUrlsBtn = document.getElementById('load-urls-btn') as HTMLButtonElement;
                const loadSampleBtn = document.getElementById('load-sample-btn') as HTMLButtonElement;

                fileInput.addEventListener('change', (e) => this.handleFileLoad(e));
                prevBtn.addEventListener('click', () => this.previousQuestion());
                nextBtn.addEventListener('click', () => this.nextQuestion());
                restartBtn.addEventListener('click', () => this.restart());
                newQuizBtn.addEventListener('click', () => this.loadNewQuiz());
                loadUrlsBtn.addEventListener('click', () => this.handleUrlLoad());
                loadSampleBtn.addEventListener('click', () => this.loadSampleQuiz());

                document.getElementById('review-start-btn')!.addEventListener('click', () => this.startReviewFromStore());
                document.getElementById('review-reset-btn')!.addEventListener('click', () => this.resetReview());

                // タブ切り替え
                document.querySelectorAll('[data-source]').forEach(tab => {
                    tab.addEventListener('click', (e) => {
                        e.preventDefault();
                        this.switchSourceTab((e.currentTarget as HTMLElement).dataset.source!);
                    });
                });

                // キーボードイベント
                document.addEventListener('keydown', (e) => this.handleKeydown(e));
            }

            private switchSourceTab(source: string) {
                // タブの状態更新
                document.querySelectorAll('[data-source]').forEach(tab => {
                    tab.classList.remove('is-active');
                    tab.setAttribute('aria-selected', 'false');
                });
                const activeTab = document.querySelector(`[data-source="${source}"]`)!;
                activeTab.classList.add('is-active');
                activeTab.setAttribute('aria-selected', 'true');

                // コンテンツの表示切り替え
                document.querySelectorAll('.source-content').forEach(content => {
                    (content as HTMLElement).style.display = 'none';
                });
                document.getElementById(`${source}-source`)!.style.display = '';
            }

            private async handleUrlLoad() {
                const textarea = document.getElementById('quiz-urls') as HTMLTextAreaElement;
                const urls = textarea.value.split('\n').map(url => url.trim()).filter(url => url);

                if (urls.length === 0) {
                    alert('URLを入力してください');
                    return;
                }

                await this.loadQuizzesFromUrls(urls);
            }

            private async loadSampleQuiz() {
                await this.loadQuizzesFromUrls(['/sample-quiz.json']);
            }

            private async loadQuizzesFromUrls(urls: string[]) {
                try {
                    this.quizQueue = [];
                    for (const url of urls) {
                        const response = await fetch(url);
                        if (!response.ok) {
                            throw new Error(`Failed to load ${url}: ${response.statusText}`);
                        }
                        const quizData = await response.json();
                        this.quizQueue.push(quizData);
                    }

                    this.currentQuizIndex = 0;
                    this.allResults = [];
                    this.startQuizFromQueue();
                } catch (error) {
                    alert('クイズの読み込みに失敗しました: ' + error);
                    console.error(error);
                }
            }

            private startQuizFromQueue() {
                if (this.currentQuizIndex < this.quizQueue.length) {
                    this.quizData = this.quizQueue[this.currentQuizIndex];
                    this.userAnswers = new Array(this.quizData.questions.length).fill(null);
                    this.startQuiz();
                }
            }

            private loadNewQuiz() {
                document.getElementById('quiz-section')!.style.display = 'none';
                document.getElementById('file-input-section')!.style.display = '';
                document.getElementById('result-section')!.style.display = 'none';

                // 状態をリセット
                this.quizData = null;
                this.quizQueue = [];
                this.currentQuizIndex = 0;
                this.allResults = [];

                this.renderReviewSection();
            }

            /** Show or hide the home review card, filling in the weak count. */
            private renderReviewSection() {
                const section = document.getElementById('review-section')!;
                const count = this.reviewStore.weakCount();

                if (count === 0) {
                    section.style.display = 'none';
                    return;
                }

                section.style.display = '';
                document.getElementById('review-count')!.textContent = `${count}問`;
                document.getElementById('review-lede')!.textContent =
                    'これまで間違えた問題です。正解するとリストから外れます。';
            }

            private startReviewFromStore() {
                const records = this.reviewStore.getWeak();
                if (records.length === 0) return;
                this.startReviewSession(this.reviewStore.buildQuiz(records));
            }

            /**
             * Run an ad-hoc quiz built from the given questions. It reuses the
             * normal queue path, so scoring, the track, and answer recording all
             * behave exactly as they do for a loaded file.
             */
            private startReviewSession(questions: QuizQuestion[]) {
                if (questions.length === 0) return;
                this.quizQueue = [{ meta: { title: '復習' }, questions }];
                this.currentQuizIndex = 0;
                this.allResults = [];
                this.startQuizFromQueue();
            }

            private resetReview() {
                if (!confirm('苦手リストを空にします。よろしいですか？（間違えた回数の記録は残ります）')) return;
                this.reviewStore.clearWeak();
                this.renderReviewSection();
            }

            private handleKeydown(event: KeyboardEvent) {
                // クイズが開始されていない場合は無効
                if (!this.quizData || document.getElementById('quiz-section')!.style.display === 'none') {
                    return;
                }

                // 1-4キーでオプション選択
                if (event.key >= '1' && event.key <= '4') {
                    event.preventDefault();
                    const optionIndex = parseInt(event.key) - 1;

                    // 既に回答が確定済みの場合は無効
                    if (this.isConfirmed) return;

                    this.selectedOption = optionIndex;
                    this.highlightSelectedOption();
                }

                // Enterキーで確定 or 次の問題へ
                else if (event.key === 'Enter') {
                    event.preventDefault();

                    if (!this.isConfirmed && this.selectedOption >= 0) {
                        // 答案確定
                        this.confirmAnswer();
                    } else if (this.isConfirmed) {
                        // 次の問題 or 次のクイズへ
                        const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
                        if (nextBtn.dataset.mode === 'quiz') {
                            this.proceedToNextQuiz();
                        } else {
                            this.nextQuestion();
                        }
                    }
                }
            }

            private async handleFileLoad(event: Event) {
                const file = (event.target as HTMLInputElement).files?.[0];
                if (!file) return;

                try {
                    const text = await file.text();
                    this.quizData = JSON.parse(text);
                    this.userAnswers = new Array(this.quizData!.questions.length).fill(null);
                    this.startQuiz();
                } catch (error) {
                    alert('ファイルの読み込みに失敗しました。正しいJSONファイルを選択してください。');
                    console.error(error);
                }
            }

            /**
             * 「次へ」ボタンのラベルと役割を必ず一組で設定する。
             * キーボード経路（Enter）はラベル文字列ではなく data-mode を見るため、
             * 表示文言を変えても分岐が壊れない。
             */
            private setNextMode(mode: 'question' | 'quiz', label: string) {
                const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
                nextBtn.dataset.mode = mode;
                nextBtn.textContent = label;
            }

            private startQuiz() {
                if (!this.quizData) return;

                document.getElementById('file-input-section')!.style.display = 'none';
                document.getElementById('quiz-section')!.style.display = '';
                document.getElementById('result-section')!.style.display = 'none';

                // 表示要素をリセット
                document.getElementById('options-container')!.style.display = '';
                document.getElementById('question-text')!.style.display = '';
                document.getElementById('prev-btn')!.style.display = '';
                document.getElementById('next-btn')!.style.display = '';
                this.setNextMode('question', '次の問題');
                document.getElementById('new-quiz-btn')!.style.display = 'none';

                const quizTitle = this.quizQueue.length > 1
                    ? `${this.quizData.meta.title} (${this.currentQuizIndex + 1}/${this.quizQueue.length})`
                    : this.quizData.meta.title;
                document.getElementById('quiz-title')!.textContent = quizTitle;

                this.currentQuestionIndex = 0;
                this.displayQuestion();
            }

            private renderTrack(final = false) {
                if (!this.quizData) return;

                const track = document.getElementById('answer-track')!;
                track.className = final ? 'track track--result' : 'track';
                track.innerHTML = '';

                this.quizData.questions.forEach((question, index) => {
                    const seg = document.createElement('span');
                    seg.className = 'track__seg';

                    const answer = this.userAnswers[index];
                    if (answer !== null) {
                        seg.classList.add(answer === question.correct ? 'is-ok' : 'is-ng');
                    }
                    if (!final && index === this.currentQuestionIndex) {
                        seg.classList.add('is-now');
                    }
                    track.appendChild(seg);
                });
            }

            private displayQuestion() {
                if (!this.quizData) return;

                const question = this.quizData.questions[this.currentQuestionIndex];
                const questionText = document.getElementById('question-text')!;
                const optionsContainer = document.getElementById('options-container')!;
                const questionCounter = document.getElementById('question-counter')!;
                const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
                const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;

                // 状態をリセット
                this.selectedOption = this.userAnswers[this.currentQuestionIndex] ?? -1;
                this.isConfirmed = this.userAnswers[this.currentQuestionIndex] !== null;

                questionText.textContent = question.question;
                questionCounter.textContent = `Q ${this.currentQuestionIndex + 1} / ${this.quizData.questions.length}`;

                this.renderTrack();

                optionsContainer.innerHTML = '';
                question.options.forEach((option, index) => {
                    const hasAnswered = this.userAnswers[this.currentQuestionIndex] !== null;

                    const optBtn = document.createElement('button');
                    optBtn.type = 'button';
                    optBtn.className = 'opt';
                    optBtn.disabled = hasAnswered;

                    const key = document.createElement('span');
                    key.className = 'opt__key';
                    key.textContent = `${index + 1}`;

                    const text = document.createElement('span');
                    text.className = 'opt__text';
                    text.textContent = option;

                    const mark = document.createElement('span');
                    mark.className = 'opt__mark';

                    optBtn.appendChild(key);
                    optBtn.appendChild(text);
                    optBtn.appendChild(mark);

                    optBtn.addEventListener('click', () => {
                        if (this.isConfirmed) return; // 回答確定済みの場合はクリック無効

                        this.selectedOption = index;
                        this.confirmAnswer();
                    });

                    optionsContainer.appendChild(optBtn);
                });

                prevBtn.disabled = this.currentQuestionIndex === 0;
                nextBtn.disabled = this.userAnswers[this.currentQuestionIndex] === null;

                if (this.userAnswers[this.currentQuestionIndex] !== null) {
                    const selectedAnswer = this.userAnswers[this.currentQuestionIndex];
                    this.showExplanation(selectedAnswer === question.correct);
                    this.updateOptionStates();
                } else {
                    document.getElementById('result-section')!.style.display = 'none';
                }
            }

            private highlightSelectedOption() {
                const options = document.querySelectorAll('#options-container .opt');

                options.forEach((option, index) => {
                    option.classList.toggle('is-selected', index === this.selectedOption);
                });
            }

            private confirmAnswer() {
                if (!this.quizData || this.selectedOption < 0) return;

                this.userAnswers[this.currentQuestionIndex] = this.selectedOption;
                this.isConfirmed = true;
                this.isAnswered = true;

                const question = this.quizData.questions[this.currentQuestionIndex];
                const isCorrect = this.selectedOption === question.correct;

                // The single recording hook: every confirmed answer — in a normal
                // quiz, a review session, or a wrong-only retry — passes here.
                this.reviewStore.record(question, isCorrect, this.quizData.meta.title);

                this.showExplanation(isCorrect);
                this.updateOptionStates();
                this.renderTrack();

                const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
                nextBtn.disabled = false;
            }

            private updateOptionStates() {
                if (!this.quizData) return;

                const question = this.quizData.questions[this.currentQuestionIndex];
                const selectedAnswer = this.userAnswers[this.currentQuestionIndex];
                const options = document.querySelectorAll('#options-container .opt');

                options.forEach((option, index) => {
                    const isSelected = selectedAnswer === index;
                    const isCorrect = index === question.correct;
                    const mark = option.querySelector('.opt__mark')!;

                    option.classList.remove('is-selected', 'is-ok', 'is-ng', 'is-dim');
                    (option as HTMLButtonElement).disabled = true;
                    mark.textContent = '';

                    if (isCorrect) {
                        option.classList.add('is-ok');
                        mark.textContent = '正解';
                    } else if (isSelected) {
                        option.classList.add('is-ng');
                        mark.textContent = 'あなたの解答';
                    } else {
                        option.classList.add('is-dim');
                    }
                });
            }

            private prefersReducedMotion(): boolean {
                return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            }

            /**
             * スコアを 0 から実数値へ回す。reduced-motion では即座に最終値を出す。
             * 「止める」のではないことが重要 — 0 のまま固まるとスコアの誤表示になる。
             */
            private tickUp(el: HTMLElement, target: number) {
                const land = () => {
                    el.textContent = String(target);
                    el.classList.add('is-landed');
                };

                if (this.prefersReducedMotion()) {
                    land();
                    return;
                }

                const duration = 1200;

                // The score is information, not decoration, so it must arrive at
                // its real value even if the animation never runs. requestAnimation-
                // Frame is suspended while the tab is hidden, so a user who looks
                // away on the last question would otherwise come back to a 0.
                const safety = window.setTimeout(land, duration + 400);

                const started = performance.now();
                const step = (now: number) => {
                    const p = Math.min((now - started) / duration, 1);
                    const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
                    el.textContent = String(Math.round(eased * target));
                    if (p < 1) {
                        requestAnimationFrame(step);
                    } else {
                        window.clearTimeout(safety);
                        land();
                    }
                };
                requestAnimationFrame(step);
            }

            private startCounters(scope: HTMLElement) {
                scope.querySelectorAll<HTMLElement>('.counter__num[data-count]').forEach(el => {
                    this.tickUp(el, Number(el.dataset.count ?? 0));
                });
            }

            private esc(text: string): string {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            private showExplanation(isCorrect: boolean) {
                if (!this.quizData) return;

                const question = this.quizData.questions[this.currentQuestionIndex];
                const resultSection = document.getElementById('result-section')!;
                const resultText = document.getElementById('result-text')!;

                resultSection.style.display = '';

                const correctAnswer = question.options[question.correct];
                const resultHtml = `
                    <p><span class="${isCorrect ? 'is-ok' : 'is-ng'}">${isCorrect ? '正解' : '不正解'}</span></p>
                    <p><strong>正解:</strong> ${this.esc(correctAnswer)}</p>
                    ${question.explanation ? `<p><strong>解説:</strong> ${this.esc(question.explanation)}</p>` : ''}
                `;

                resultText.innerHTML = resultHtml;
            }

            private previousQuestion() {
                if (this.currentQuestionIndex > 0) {
                    this.currentQuestionIndex--;
                    this.displayQuestion();
                }
            }

            private nextQuestion() {
                if (this.currentQuestionIndex < this.quizData!.questions.length - 1) {
                    this.currentQuestionIndex++;
                    this.displayQuestion();
                } else {
                    // クイズ終了時は必ずshowFinalResultsを呼ぶ
                    this.showFinalResults();
                }
            }

            private proceedToNextQuiz() {
                if (this.currentQuizIndex + 1 < this.quizQueue.length) {
                    this.currentQuizIndex++;
                    this.startQuizFromQueue();
                }
            }

            private showFinalResults() {
                if (!this.quizData) return;

                const correctCount = this.userAnswers.filter((answer, index) =>
                    answer === this.quizData!.questions[index].correct
                ).length;

                // Offer a wrong-only retry only on the true end of the run (a
                // single quiz, or the last of a queue), scoped to this quiz's misses.
                const hasNextQuiz = this.currentQuizIndex + 1 < this.quizQueue.length;
                this.sessionWrong = hasNextQuiz
                    ? []
                    : this.quizData.questions.filter((q, i) => this.userAnswers[i] !== q.correct);

                const totalQuestions = this.quizData.questions.length;
                const percentage = Math.round((correctCount / totalQuestions) * 100);

                // 現在のクイズ結果を記録
                this.allResults.push({
                    title: this.quizData.meta.title,
                    correct: correctCount,
                    total: totalQuestions
                });

                // 選択肢と問題文を非表示にし、結果のみ表示
                document.getElementById('options-container')!.style.display = 'none';
                document.getElementById('question-text')!.style.display = 'none';

                // トラックを結果表示モードへ
                this.renderTrack(true);

                let resultHtml = `
                    <div class="counter">
                        <span class="counter__num" data-count="${correctCount}">0</span>
                        <span class="counter__of">/ ${totalQuestions} 問正解</span>
                    </div>
                    <p>正答率 ${percentage}%</p>`;

                // 次のクイズがある場合の処理
                if (this.currentQuizIndex + 1 < this.quizQueue.length) {
                    resultHtml += `<p style="margin-top: 12px;">次のクイズに進みますか？</p>`;
                    this.setNextMode('quiz', '次のクイズへ');
                    (document.getElementById('next-btn') as HTMLButtonElement).disabled = false;

                    // 次のクイズボタンのイベントリスナーを更新
                    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
                    nextBtn.replaceWith(nextBtn.cloneNode(true));
                    const newNextBtn = document.getElementById('next-btn') as HTMLButtonElement;
                    newNextBtn.addEventListener('click', () => this.proceedToNextQuiz());
                } else if (this.quizQueue.length > 1) {
                    // 全クイズ完了時の総合結果
                    const totalCorrect = this.allResults.reduce((sum, result) => sum + result.correct, 0);
                    const grandTotal = this.allResults.reduce((sum, result) => sum + result.total, 0);
                    const overallPercentage = Math.round((totalCorrect / grandTotal) * 100);

                    resultHtml += `<hr class="divider" />
                        <h3>すべての結果</h3>
                        <div class="counter">
                            <span class="counter__num" data-count="${totalCorrect}">0</span>
                            <span class="counter__of">/ ${grandTotal} 問正解</span>
                        </div>
                        <p>総合正答率 ${overallPercentage}%</p>
                        <div class="result-list">`;

                    this.allResults.forEach(result => {
                        const percent = Math.round((result.correct / result.total) * 100);
                        resultHtml += `<p>${this.esc(result.title)}: ${result.correct}/${result.total}（${percent}%）</p>`;
                    });

                    resultHtml += `</div></div>`;
                    document.getElementById('next-btn')!.style.display = 'none';
                } else {
                    document.getElementById('next-btn')!.style.display = 'none';
                }

                if (this.sessionWrong.length > 0) {
                    resultHtml += `
                        <div class="btn-row" style="margin-top: var(--space-md);">
                            <button type="button" class="btn" id="retry-wrong-btn">間違えた問題だけやり直す（${this.sessionWrong.length}問）</button>
                        </div>`;
                }

                const resultText = document.getElementById('result-text')!;
                resultText.innerHTML = resultHtml;
                document.getElementById('result-section')!.style.display = '';
                this.startCounters(resultText);

                document.getElementById('retry-wrong-btn')?.addEventListener(
                    'click',
                    () => this.startReviewSession(this.sessionWrong),
                );

                // ボタンの表示制御
                document.getElementById('new-quiz-btn')!.style.display = '';
                document.getElementById('prev-btn')!.style.display = 'none';
            }

            private restart() {
                this.currentQuestionIndex = 0;
                this.userAnswers = new Array(this.quizData!.questions.length).fill(null);
                this.isAnswered = false;
                this.selectedOption = -1;
                this.isConfirmed = false;
                document.getElementById('result-section')!.style.display = 'none';
                document.getElementById('options-container')!.style.display = '';
                document.getElementById('question-text')!.style.display = '';
                document.getElementById('new-quiz-btn')!.style.display = 'none';
                document.getElementById('next-btn')!.style.display = '';
                this.setNextMode('question', '次の問題');
                document.getElementById('prev-btn')!.style.display = '';
                this.displayQuestion();
            }
        }

        new QuizApp();
    </script>
</Layout>
